{
  "manifest_version": 3,
  "name": "MASH-Mix-Audio-and-Text",
  "version": "1.8.1",
  "description": "Measure any song in your browser: peak, loudness, clipping, dc offset, crest, the key and the tempo. With the local engine it also writes the lyrics, from a file or from a link. Nothing leaves your machine.",
  "minimum_chrome_version": "114",
  "author": "MASH (Khaled Bhuiyan)",
  "homepage_url": "https://github.com/kdbn121/MASH-Mix-Audio-and-Text-Extension",
  "action": {
    "default_title": "MASH-Mix",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options/options.html",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
